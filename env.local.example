NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Necesaria para las funciones de IA (generar recetas, ayudar a completar
# una receta, adaptar a tu despensa). Se usa solo en el servidor, nunca se
# expone al navegador.
ANTHROPIC_API_KEY=TU-CLAVE-DE-API

# Opcional: qué modelo usar. Si no la defines, se usa claude-sonnet-5.
AI_MODEL=claude-sonnet-5
